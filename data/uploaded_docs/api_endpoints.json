{
  "description": "API Endpoints for E-Shop Checkout System",
  "base_url": "https://api.eshop.com/v1",
  "endpoints": {
    "POST /apply_coupon": {
      "description": "Apply a discount coupon code to the current order",
      "request_body": {
        "code": "string",
        "required": true,
        "example": "SAVE15"
      },
      "response": {
        "success": {
          "status": 200,
          "body": {
            "discount_percent": 15,
            "discount_amount": 25.50,
            "message": "Discount applied successfully"
          }
        },
        "error": {
          "status": 400,
          "body": {
            "error": "Invalid discount code",
            "message": "The provided discount code is not valid"
          }
        }
      }
    },
    "POST /submit_order": {
      "description": "Submit the checkout order with customer details",
      "request_body": {
        "name": "string",
        "email": "string",
        "address": "string",
        "shipping_method": "string",
        "payment_method": "string",
        "cart_items": "array",
        "discount_code": "string",
        "required_fields": ["name", "email", "address", "shipping_method", "payment_method", "cart_items"]
      },
      "request_example": {
        "name": "John Doe",
        "email": "john.doe@example.com",
        "address": "123 Main St, City, State 12345",
        "shipping_method": "express",
        "payment_method": "credit_card",
        "cart_items": [
          {
            "product_id": "product-1",
            "quantity": 2,
            "price": 79.99
          }
        ],
        "discount_code": "SAVE15"
      },
      "response": {
        "success": {
          "status": 200,
          "body": {
            "order_id": "ORD-12345",
            "status": "payment_successful",
            "message": "Order submitted successfully",
            "total_amount": 315.97
          }
        },
        "error": {
          "status": 400,
          "body": {
            "error": "Validation failed",
            "message": "Please check your form fields",
            "errors": {
              "email": "Invalid email format",
              "address": "Address is required"
            }
          }
        }
      }
    },
    "GET /cart": {
      "description": "Retrieve current cart contents",
      "response": {
        "status": 200,
        "body": {
          "items": [
            {
              "product_id": "product-1",
              "name": "Wireless Headphones",
              "quantity": 2,
              "price": 79.99,
              "subtotal": 159.98
            }
          ],
          "subtotal": 359.97,
          "discount": 0,
          "shipping": 10.00,
          "total": 369.97
        }
      }
    },
    "POST /cart/add": {
      "description": "Add item to cart",
      "request_body": {
        "product_id": "string",
        "quantity": "integer",
        "required": true
      },
      "response": {
        "status": 200,
        "body": {
          "message": "Item added to cart",
          "cart_item": {
            "product_id": "product-1",
            "name": "Wireless Headphones",
            "quantity": 1,
            "price": 79.99
          }
        }
      }
    },
    "PUT /cart/update": {
      "description": "Update cart item quantity",
      "request_body": {
        "product_id": "string",
        "quantity": "integer",
        "required": true
      },
      "response": {
        "status": 200,
        "body": {
          "message": "Cart updated",
          "cart_item": {
            "product_id": "product-1",
            "quantity": 3
          }
        }
      }
    },
    "DELETE /cart/remove": {
      "description": "Remove item from cart",
      "request_body": {
        "product_id": "string",
        "required": true
      },
      "response": {
        "status": 200,
        "body": {
          "message": "Item removed from cart"
        }
      }
    },
    "GET /shipping/methods": {
      "description": "Get available shipping methods",
      "response": {
        "status": 200,
        "body": {
          "methods": [
            {
              "id": "standard",
              "name": "Standard Shipping",
              "cost": 0.00,
              "delivery_days": "5-7 business days"
            },
            {
              "id": "express",
              "name": "Express Shipping",
              "cost": 10.00,
              "delivery_days": "2-3 business days"
            }
          ]
        }
      }
    },
    "GET /payment/methods": {
      "description": "Get available payment methods",
      "response": {
        "status": 200,
        "body": {
          "methods": [
            {
              "id": "credit_card",
              "name": "Credit Card",
              "enabled": true
            },
            {
              "id": "paypal",
              "name": "PayPal",
              "enabled": true
            }
          ]
        }
      }
    }
  },
  "validation_rules": {
    "email": {
      "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
      "required": true,
      "error_message": "Please enter a valid email address"
    },
    "name": {
      "min_length": 2,
      "required": true,
      "error_message": "Name is required"
    },
    "address": {
      "min_length": 10,
      "required": true,
      "error_message": "Address is required"
    },
    "discount_code": {
      "valid_codes": ["SAVE10", "SAVE15", "SAVE20", "WELCOME"],
      "case_sensitive": true,
      "error_message": "Invalid discount code"
    }
  },
  "error_codes": {
    "VALIDATION_ERROR": 400,
    "INVALID_COUPON": 400,
    "CART_EMPTY": 400,
    "PAYMENT_FAILED": 402,
    "SERVER_ERROR": 500
  }
}

